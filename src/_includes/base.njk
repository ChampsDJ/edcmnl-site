<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {%- set pageTitle = title or site.title %}
  {%- set pageDescription = description or excerpt or site.description %}
  {%- set pageImage = (coverImage or site.logoImage) | absoluteUrl(site.url) %}
  {%- set pageUrl = page.url | absoluteUrl(site.url) %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ pageUrl }}">
  <meta name="theme-color" content="#ff3d7f">

  <!-- Open Graph (Discord, Facebook, Slack, LinkedIn, etc. all read these) -->
  <meta property="og:type" content="{{ 'article' if coverImage else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:alt" content="{{ pageTitle }}">

  <!-- X / Twitter card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">

  <!-- Structured data, for Google -->
  {%- if coverImage %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "headline": {{ title | dump | safe }},
    "name": {{ title | dump | safe }},
    "description": {{ pageDescription | dump | safe }},
    "image": {{ pageImage | dump | safe }},
    "datePublished": {{ date | isoDate | dump | safe }},
    "url": {{ pageUrl | dump | safe }},
    "publisher": {
      "@type": "Organization",
      "name": {{ site.title | dump | safe }},
      "url": {{ site.url | dump | safe }}
    }
  }
  </script>
  {%- else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.title | dump | safe }},
    "url": {{ (site.url + "/") | dump | safe }},
    "description": {{ site.description | dump | safe }}
  }
  </script>
  {%- endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/site/edcfav.ico">
</head>
<body>
  <div class="skyline" aria-hidden="true"></div>

  <header class="site-header">
    <a class="site-header__brand" href="/">
      <img class="site-header__banner" src="{{ site.logoImage }}" alt="{{ site.title }}" width="800" height="99">
    </a>
    <nav class="site-header__nav">
      <a href="{{ site.twitch }}" class="site-header__icon site-header__icon--twitch" aria-label="Twitch"></a>
      <a href="{{ site.discord }}" class="site-header__icon site-header__icon--discord" aria-label="Discord"></a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <img class="site-footer__mascot" src="{{ site.mascotImage }}" alt="EDC Discord MNL mascot" width="1600" height="1035" loading="lazy">
    <p class="site-footer__tagline">Until we meet again Under the Electric Sky... we vibe on Discord.</p>
    <ul class="site-footer__links">
      {% for link in site.links %}
      <li><a href="{{ link.url }}">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
    <p class="site-footer__est">Est. {{ site.founded }} &mdash; {{ site.title }}</p>
  </footer>
</body>
</html>
